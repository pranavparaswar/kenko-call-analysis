# Copy this file to `.env` and fill in your real keys, OR just export these
# in your shell before running the pipeline. Do NOT commit the real .env.

# Callyzer API token (call logs + recording URLs)
CALLYZER_TOKEN=your_callyzer_token_here

# Sarvam API key (transcription + analysis)
SARVAM_API_KEY=your_sarvam_key_here

# Service account JSON (single line) for kenko-nightly-report-uploader, used
# by sales_nightly_report.py --cloud to upload dashboard.html directly to
# Drive instead of attaching it. Must be a member (Content Manager) of the
# Shared Drive below.
GDRIVE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# ID of the "Kenko Sales Reports" Shared Drive the service account uploads into
GDRIVE_SHARED_DRIVE_ID=your_shared_drive_id_here
